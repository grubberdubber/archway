# zathura — vim keys are built in; this file only colours it and sets sane
# defaults. Colours follow the Android Mount palette (themes/android-mount/).

# --- Look ---------------------------------------------------------------
# Colours are generated by `archway theme set` (themes/_shared/zathura), so a
# theme switch repaints the reader without touching this file. The include is
# first: anything set below wins over the theme on purpose.
include "~/.config/archway/theme.d/zathura-theme"

set font "JetBrainsMono Nerd Font 10"
set guioptions ""

# No recolouring of the page: a scanned PDF or a coloured figure is content,
# not chrome. Ctrl+R toggles invert/recolour if a page is unreadable.
set recolor "false"
set recolor-keephue "true"

# --- Behaviour ----------------------------------------------------------
set adjust-open "width"
set page-padding 8
set scroll-step 80
set zoom-min 20
set zoom-max 500
set selection-clipboard "clipboard"
set database "sqlite"
set dbus-service "true"

# Links open in the browser without a confirmation prompt.
set link-open-external "true"

# --- Keys (on top of zathura's vim defaults) ----------------------------
# j/k scroll one line, J/K one page: the defaults scroll half a page, which
# loses the reader's place.
map j scroll down
map k scroll up
map J scroll full-down
map K scroll full-up
map <C-d> scroll half-down
map <C-u> scroll half-up

# Ctrl+R recolours (dark mode for bright slides), Ctrl+I inverts.
map <C-r> recolor
map <C-i> invert

# Ctrl+Shift+C copies the selection and clears it, like a terminal.
map <C-S-c> feedkeys ":exec \"set selection-clipboard clipboard\"<Return>"
