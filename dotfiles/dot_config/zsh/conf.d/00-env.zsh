# Environment and XDG defaults.

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R -F -X -i -M'
export MANPAGER='bat --style=plain --pager=never --language=man'
export SYSTEMD_PAGER=less

# Nerd Font glyphs render correctly in kitty; keep UTF-8 explicit.
export LANG=${LANG:-en_US.UTF-8}
export LC_ALL=

# Theme fragments generated by `archway theme set`.
export ARCHWAY_THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/archway/theme.d"
export STARSHIP_CONFIG="$ARCHWAY_THEME_DIR/starship.toml"
export BAT_THEME="archway"

# Tool configs that respect XDG but default to $HOME.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
export GOPATH="${GOPATH:-$HOME/.local/share/go}"
export npm_config_cache="${npm_config_cache:-${XDG_CACHE_HOME:-$HOME/.cache}/npm}"
export PYTHONUSERBASE="${PYTHONUSERBASE:-$HOME/.local}"

# ssh-agent from the Bitwarden/keyring agent, if present.
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$HOME/.ssh/agent.sock}"

# Add user binaries once, without duplicating entries.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
