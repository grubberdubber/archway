# Archway dunst — colours and geometry come from the theme drop-in
# (~/.config/dunst/dunstrc.d/90-android-mount.conf, generated).

[global]
    monitor = 0
    follow = mouse
    width = 380
    height = 300
    origin = top-right
    offset = 14x14
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 380

    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    gap_size = 8
    sort = yes
    idle_threshold = 120

    alignment = left
    vertical_alignment = center
    show_age_threshold = 90
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    icon_path = /usr/share/icons/Adwaita/48x48/status/:/usr/share/icons/Adwaita/48x48/devices/

    sticky_history = yes
    history_length = 50
    dmenu = rofi -dmenu -p dunst:
    browser = xdg-open

    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# Local overrides belong in ~/.config/dunst/dunstrc.d/99-local.conf.
