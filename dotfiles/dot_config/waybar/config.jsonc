// SPDX-License-Identifier: GPL-3.0-or-later
// Archway waybar — Hyprland modules only. Colours live in theme.css, which
// `archway theme set` publishes from the palette.
//
// Layout: one centred row of three zones — session/shell, the identifiers that
// change most (window, media, clock), then status — separated by a wider break
// than the one between pills. Centring the row keeps it balanced on any screen
// width; the zone breaks are drawn in style.css with extra margins. The clock always shows
// date + time, so no click changes the row width; the alt format only makes it
// shorter, and the tooltip still carries the full calendar.
// Every alert/resource module prints an empty text when healthy, so the bar
// stays around eight pills and only grows when something needs attention.
//
// Icons are Nerd Font glyphs written as JSON escapes (\uf028 = volume, ...) so
// the file stays portable; colour per state comes from style.css, not the JSON.
// `archway` is not on Hyprland's PATH, so helpers are called by absolute path.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "modules-left": [],
  "modules-center": [
    "custom/launcher",
    "hyprland/workspaces",
    "group/context",
    "custom/media",
    "clock",
    "custom/notifications",
    "group/alerts",
    "group/net",
    "group/resources",
    "group/controls",
    "group/session"
  ],
  "modules-right": [],

  "group/context": {
    "orientation": "horizontal",
    "modules": ["hyprland/submap", "custom/scratchpad", "hyprland/window"]
  },
  "group/alerts": {
    "orientation": "horizontal",
    "modules": [
      "privacy",
      "custom/recording",
      "custom/failed",
      "custom/updates",
      "custom/vault"
    ]
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": ["custom/vpn", "network", "bluetooth"]
  },
  "group/resources": {
    "orientation": "horizontal",
    "modules": ["custom/resources", "custom/disk"]
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "backlight",
      "custom/nightlight",
      "custom/language",
      "idle_inhibitor"
    ]
  },
  "group/session": {
    "orientation": "horizontal",
    "modules": ["battery", "custom/gaming", "tray", "custom/power"]
  },

  "custom/launcher": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
      "*": 6
    }
  },
  "hyprland/submap": {
    "format": "\uf0ad {}",
    "tooltip": false
  },
  "custom/scratchpad": {
    "exec": "$HOME/.local/bin/archway-bar scratchpad",
    "return-type": "json",
    "interval": 5,
    "on-click": "hyprctl dispatch togglespecialworkspace",
    "tooltip": true
  },
  "hyprland/window": {
    "max-length": 11,
    "separate-outputs": true,
    "tooltip": false
  },

  "clock": {
    "format": "{:%d/%m %H:%M}",
    // No format-alt on purpose: waybar toggles it on every left click, and rapid
    // clicking used to leave the pill flickering between two widths. The date
    // never changes size, so the row stays put.
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  // The one media pill: icon + "artist — title", with the playback position and
  // length in the tooltip. A timer printed on the bar changed the pill width
  // every second, so the row never stopped moving; hover is where the clock
  // belongs. It also stands in while no player is running, which keeps the slot
  // from disappearing and re-centring the row.
  "custom/media": {
    "exec": "$HOME/.local/bin/archway-bar media",
    "return-type": "json",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/notifications": {
    "exec": "$HOME/.local/bin/archway-bar notifications",
    "return-type": "json",
    "interval": 3,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "tooltip": true
  },

  "privacy": {
    "icon-size": 13,
    "tooltip": true
  },
  "custom/recording": {
    "exec": "$HOME/.local/bin/archway-bar recording",
    "return-type": "json",
    "interval": 2,
    "on-click": "pkill -x wf-recorder",
    "tooltip": true
  },
  "custom/failed": {
    "exec": "$HOME/.local/bin/archway-bar failed",
    "return-type": "json",
    "interval": 15,
    // waybar spawns the click command without a shell stdin, so a bare
    // `systemctl --failed` printed and the window closed before it could be
    // read. The `read` waits on the terminal itself, not on waybar's stdin.
    "on-click": "kitty --class floating-term -e sh -c 'systemctl --failed --no-pager; printf \"\n%s\n\" \"Press Enter to close\"; read -r _ </dev/tty'",
    "tooltip": true
  },
  "custom/updates": {
    "exec": "$HOME/.local/bin/archway-bar updates",
    "return-type": "json",
    "interval": 1800,
    // `--list` runs `checkupdates` on a private sync-db copy, so clicking while
    // the module refreshes no longer trips its lock ("Cannot fetch updates").
    "on-click": "kitty --class floating-term -e sh -c '$HOME/.local/bin/archway-bar updates --list; printf \"\n%s\n\" \"Press Enter to close\"; read -r _ </dev/tty'",
    "on-click-right": "$HOME/.local/bin/archway update --dry-run",
    "tooltip": true
  },
  "custom/vault": {
    "exec": "$HOME/.local/bin/archway-bar vault",
    "return-type": "json",
    "interval": 15,
    "on-click": "kitty -e rbw unlock",
    "tooltip": true
  },

  "custom/vpn": {
    "exec": "$HOME/.local/bin/archway-bar vpn",
    "return-type": "json",
    "interval": 15,
    "on-click": "kitty -e nmtui",
    "tooltip": true
  },
  "network": {
    "format-wifi": "\uf1eb {essid}",
    "format-ethernet": "\uf0e8 {ifname}",
    "format-linked": "\uf0e8 {ifname}",
    "format-disconnected": "\uf05e offline",
    "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
    "on-click": "$HOME/.local/bin/archway applet network --rofi",
    "on-click-right": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "\uf293 {status}",
    "format-disabled": "\uf293 off",
    "format-connected": "\uf293 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "on-click": "blueman-manager"
  },

  "custom/resources": {
    "exec": "$HOME/.local/bin/archway-bar resources",
    "return-type": "json",
    "interval": 5,
    "on-click": "kitty -e btop",
    "tooltip": true
  },
  "custom/disk": {
    "exec": "$HOME/.local/bin/archway-bar disk",
    "return-type": "json",
    "interval": 60,
    "on-click": "kitty -e ncdu /",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026 {volume}%",
    "format-source": "\uf130 {volume}%",
    "format-source-muted": "\uf131",
    "format-icons": ["\uf027", "\uf027", "\uf028"],
    "tooltip-format": "{desc}",
    "on-click": "pavucontrol",
    "on-scroll-up": "$HOME/.local/bin/archway applet osd volume up",
    "on-scroll-down": "$HOME/.local/bin/archway applet osd volume down",
    "scroll-step": 5
  },
  "backlight": {
    "format": "\uf185 {percent}%",
    "tooltip": false,
    "on-scroll-up": "$HOME/.local/bin/archway applet osd brightness up",
    "on-scroll-down": "$HOME/.local/bin/archway applet osd brightness down",
    "scroll-step": 5
  },
  "custom/nightlight": {
    "exec": "$HOME/.local/bin/archway-bar nightlight",
    "return-type": "json",
    "interval": 30,
    "on-click": "$HOME/.local/bin/archway-bar nightlight --toggle",
    "tooltip": true
  },
  "custom/language": {
    "exec": "$HOME/.local/bin/archway-bar language",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf06e",
      "deactivated": "\uf070"
    },
    "tooltip-format-activated": "keep-awake on",
    "tooltip-format-deactivated": "keep-awake off"
  },

  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf0e7 {capacity}%",
    "format-full": "\uf240 {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{timeTo}",
    "on-click": "$HOME/.local/bin/archway applet power --rofi"
  },
  // The rocket pill: gaming mode on the left click, power profile on the right.
  "custom/gaming": {
    "exec": "$HOME/.local/bin/archway-bar gaming",
    "return-type": "json",
    "interval": 10,
    "on-click": "$HOME/.local/bin/archway applet gaming toggle",
    "on-click-right": "$HOME/.local/bin/archway-bar power-profile --next",
    "tooltip": true
  },
  "tray": {
    "icon-size": 14,
    "spacing": 4
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/archway applet power --rofi"
  }
}
