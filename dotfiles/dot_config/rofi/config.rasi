/* SPDX-License-Identifier: GPL-3.0-or-later
 * Archway rofi — launcher, windows, run and ssh.
 * Applets (theme, power, android-mount) are invoked with their own -modi so
 * rofi never has to guess a script path.
 *
 * No kb-* overrides: rofi already binds Up/Down/Control+k/Control+j/Tab to the
 * actions below, and re-declaring them makes it print "binding ... is already
 * bound" on every launch (the Super+D error). Visuals: theme.d/rofi.rasi. */

@theme "~/.config/archway/theme.d/rofi.rasi"

configuration {
    modi:                "drun,run,window,ssh";
    show-icons:          true;
    icon-theme:          "Papirus";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    display-ssh:         "SSH";
    drun-display-format: "{name}";
    disable-history:     false;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}
