# Archway — SSH defaults. Included from ~/.ssh/config with:
#
#     Include ~/.config/archway/ssh_config
#
# It is a separate file on purpose: ~/.ssh holds keys and known hosts, and a
# dotfile manager that rewrites files in there is one mistake away from locking
# you out. Hosts and identities stay in ~/.ssh/config, below the Include.

# One TCP connection reused for 10 minutes: a second `ssh`, `git push` or
# `scp` skips the handshake entirely.
Host *
	ControlMaster auto
	ControlPath ~/.ssh/cm-%r@%h:%p
	ControlPersist 10m

	# Keep long sessions alive through NAT and laptop suspend.
	ServerAliveInterval 30
	ServerAliveCountMax 3
	TCPKeepAlive yes

	# Only the key you named is offered. This is what makes agent forwarding
	# and multi-key setups predictable, and it avoids "too many authentication
	# failures" from an agent with a dozen identities.
	IdentitiesOnly yes

	# AddKeysToAgent lets the first use of a key load it into the agent.
	AddKeysToAgent yes

	# Never store plaintext hostnames in known_hosts.
	HashKnownHosts yes

	# Compression helps on slow links and costs a little CPU on fast ones; the
	# common case for this laptop is a remote host over mobile data.
	Compression yes

	# Modern key exchange and signatures (OpenSSH 9+ still negotiates an old
	# server; these are the algorithms a 2020s client should pick first).
	KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
	HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256
	PubkeyAcceptedAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

	# Fail fast when a host is unreachable instead of hanging a terminal.
	ConnectTimeout 10
