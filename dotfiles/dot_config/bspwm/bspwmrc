#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Archway bspwm session. Managed by chezmoi — local edits will be reported by
# `archway update` instead of being overwritten silently.

# shellcheck shell=sh

# Only one window manager per display.
if pgrep -x sxhkd >/dev/null 2>&1; then
  :
else
  sxhkd &
fi

# Nine workspaces, matching keybinds/keybinds.toml.
bspc monitor -d 1 2 3 4 5 6 7 8 9

# Focus follows the pointer, but never steals focus.
bspc config focus_follows_pointer true
bspc config pointer_follows_monitor true
bspc config pointer_follows_focus false
bspc config click_to_focus button1

# Layout defaults
bspc config border_width 1
bspc config window_gap 14
bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config single_monocle true
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true

# Floating scratchpad terminal and dialogs
bspc rule -a floating-term state=floating follow=on center=on border=on
bspc rule -a Yad state=floating center=on
bspc rule -a Gimp state=floating
bspc rule -a feh state=floating
bspc rule -a Zathura state=tiled

# Theme (generated by `archway theme set`)
if [ -r "$HOME/.config/archway/theme.d/bspwm.sh" ]; then
  . "$HOME/.config/archway/theme.d/bspwm.sh"
fi

# Compositor: rounded corners, subtle shadows, no unnecessary eye candy.
if command -v picom >/dev/null 2>&1; then
  picom --config "$HOME/.config/picom/picom.conf" --daemon
fi

# Status bar
if command -v polybar >/dev/null 2>&1; then
  polybar --reload main >/dev/null 2>&1 &
fi

# Notifications
if command -v dunst >/dev/null 2>&1; then
  pgrep -x dunst >/dev/null 2>&1 || dunst &
fi

# Wallpaper: Archway ships no art, so use the theme background colour.
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid '#0B0F14'
fi

# Cursor
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -cursor_name left_ptr
fi

# Accessibility: keep the compose key available and do not force a layout.
if command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap -option compose:ralt
fi
