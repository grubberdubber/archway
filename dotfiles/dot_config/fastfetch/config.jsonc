// SPDX-License-Identifier: GPL-3.0-or-later
// fastfetch — the shell's "hello". Two columns, no ASCII banner, monochrome
// labels with one accent. Everything that costs a slow call (GPU, weather,
// media) is left out; `archway doctor` covers the rest.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
    },
  },
  "modules": [
    {
      "type": "title",
      "key": "",
    },
    {
      "type": "separator",
      "string": "─",
    },
    "os",
    "kernel",
    "wm",
    "shell",
    "terminal",
    "uptime",
    {
      "type": "packages",
      "format": "{}",
    },
    {
      "type": "cpu",
      "format": "{}",
    },
    "gpu",
    {
      "type": "memory",
      "format": "{} / {}",
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{} / {}",
    },
    "localip",
    {
      "type": "colors",
      "symbol": "block",
    },
  ],
}
