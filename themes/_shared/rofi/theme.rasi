/* Android Mount — rofi theme. Generated by archway; do not edit.
 * Palette values are inlined by the renderer; no rasi indirection is used so
 * there is exactly one source of truth. */

* {
    background-color: transparent;
    text-color:       @text@;
    /* Monospace keeps Nerd Font icons (Wi-Fi, locks, battery) rendering. */
    font:             "@font_mono@ @font_size@";
    margin:           0;
    padding:          0;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    /* 480px fits a 1366x768 panel without touching the edges. */
    width:            480px;
    border:           @focus_width@px;
    border-color:     @primary@;
    border-radius:    @radius_window@px;
    background-color: @bg@;
    padding:          12px;
}

mainbox {
    children:     [ inputbar, listview ];
    spacing:      8px;
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @surface@;
    border-radius:    @radius_input@px;
    padding:          6px 10px;
    spacing:          8px;
}

prompt {
    text-color: @primary@;
}

entry {
    placeholder:       "Search";
    placeholder-color: @text_muted@;
    text-color:        @text@;
}

listview {
    lines:        9;
    columns:      1;
    spacing:      2px;
    scrollbar:    false;
    background-color: transparent;
}

element {
    padding:          6px 10px;
    border-radius:    @radius_input@px;
    background-color: transparent;
    text-color:       @text@;
}

element selected {
    background-color: @selection_bg@;
    text-color:       @primary@;
}

element urgent {
    text-color: @error@;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
}

element-icon {
    size: 18px;
    background-color: transparent;
}

scrollbar {
    width: 4px;
    handle-color: @primary@;
    handle-width: 4px;
}
