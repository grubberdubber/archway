#!/usr/bin/env bats
# SPDX-License-Identifier: GPL-3.0-or-later

setup() {
  # shellcheck source=../helpers/common.bash
  source "$BATS_TEST_DIRNAME/../helpers/common.bash"
  setup_sandbox
}

teardown() {
  teardown_sandbox
}

@test "contrast ratio of black on white is 21:1" {
  assert_eq "21.00" "$(contrast_ratio '#000000' '#FFFFFF')"
}

@test "contrast ratio is symmetric" {
  assert_eq "$(contrast_ratio '#8AB4F8' '#0B0F14')" "$(contrast_ratio '#0B0F14' '#8AB4F8')"
}

@test "palette parser reads hex colours, not comments" {
  theme_load_palette android-mount
  assert_eq "#0B0F14" "${PALETTE[bg]}"
  assert_eq "#E6EDF3" "${PALETTE[text]}"
  assert_eq "12" "${PALETTE[radius_window]}"
}

@test "android-mount passes AA validation" {
  run theme_validate android-mount
  assert_eq 0 "$status"
}

@test "every template renders without leaving tokens" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_load_palette android-mount
  theme_render android-mount "$dest"
  run grep -rn '@[a-z_]*@' "$dest"
  assert_eq 1 "$status" # grep exits 1 when nothing matches
}

@test "rendered kitty config contains the palette background" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_load_palette android-mount
  theme_render android-mount "$dest"
  assert_file_contains "$dest/kitty.conf" "background            #0B0F14"
}

@test "Neovim artifact matches the palette (contract)" {
  run theme_nvim_contract android-mount
  assert_eq 0 "$status"
}

@test "an invalid palette fails validation" {
  local dir="$SANDBOX/themes/bad"
  mkdir -p "$dir"
  printf '[palette]\nbg = "not-a-colour"\ntext = "#FFFFFF"\n' > "$dir/palette.toml"
  THEMES_DIR="$SANDBOX/themes" run theme_validate bad
  assert_eq 1 "$status"
}

@test "reload never blocks on a notification daemon that is not running" {
  mkdir -p -- "$SANDBOX/bin"
  cat > "$SANDBOX/bin/swaync-client" << 'STUB'
#!/usr/bin/env bash
touch "$HOME/swaync-was-called"
sleep 30
STUB
  chmod +x -- "$SANDBOX/bin/swaync-client"
  # A real swaync on the host would make pgrep succeed and hit the stub; the
  # test must not depend on what the developer is running.
  printf '#!/bin/sh\nexit 1\n' > "$SANDBOX/bin/pgrep"
  chmod +x -- "$SANDBOX/bin/pgrep"
  PATH="$SANDBOX/bin:$PATH" run timeout 10 bash -c 'source "$ARCHWAY_ROOT/lib/core.sh"; source "$ARCHWAY_ROOT/lib/paths.sh"; source "$ARCHWAY_ROOT/lib/ui.sh"; source "$ARCHWAY_ROOT/lib/theme.sh"; theme_reload'
  assert_eq 0 "$status"
  [ ! -e "$HOME/swaync-was-called" ]
}

@test "every monochrome variant validates against AA" {
  local id
  for id in mono-blue mono-teal mono-green mono-yellow mono-orange mono-red mono-pink mono-purple mono-slate; do
    run theme_validate "$id"
    assert_eq 0 "$status" "theme $id failed validation"
  done
}

@test "a variant without its own templates renders from themes/_shared" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render mono-pink "$dest"
  assert_file_contains "$dest/kitty.conf" "#F4A6C8"
  assert_file_contains "$dest/waybar.css" "#F4A6C8"
  assert_missing "$dest/nvim"
  run grep -rn '@[a-z_]*@' "$dest"
  assert_eq 1 "$status"
}

@test "jan passes AA validation with the reference palette" {
  run theme_validate jan
  assert_eq 0 "$status"
  theme_load_palette jan
  assert_eq "#070219" "${PALETTE[bg]}"
  assert_eq "#27FBFE" "${PALETTE[primary]}"
}

@test "jan renders the exact 16-colour terminal from the reference" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render jan "$dest"
  assert_file_contains "$dest/kitty.conf" "color0  #626483"
  assert_file_contains "$dest/kitty.conf" "color1  #FB007A"
  assert_file_contains "$dest/kitty.conf" "color4  #19BFFE"
  assert_file_contains "$dest/kitty.conf" "color12 #58AFC2"
  assert_file_contains "$dest/kitty.conf" "color13 #472575"
  assert_file_contains "$dest/kitty.conf" "color14 #926BCA"
  assert_file_contains "$dest/kitty.conf" "background            #070219"
  run grep -rn '@[a-z_]*@' "$dest"
  assert_eq 1 "$status"
}

@test "a theme override appends to the shared stylesheet instead of replacing it" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render jan "$dest"
  # Shared rules survive...
  assert_file_contains "$dest/waybar.css" "#custom-launcher,"
  assert_file_contains "$dest/waybar.css" "background: #070219"
  # ...and the flush geometry lands after them, so it wins the cascade.
  run bash -c 'grep -n "waybar. Generated by archway" "$1" | head -n1 | cut -d: -f1' _ "$dest/waybar.css"
  local base_line=$output
  run bash -c 'grep -n "Waybar overrides" "$1" | head -n1 | cut -d: -f1' _ "$dest/waybar.css"
  [ "$output" -gt "$base_line" ]
}

@test "jan softens the focus border and tightens the gaps" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render jan "$dest"
  assert_file_contains "$dest/hyprland.lua" "border_size = 1"
  assert_file_contains "$dest/hyprland.lua" "active_border = \"rgba(27FBFE59)\""
  assert_file_contains "$dest/hyprland.lua" "gaps_in = 3"
  assert_file_contains "$dest/hyprland.lua" "gaps_out = 5"
}

@test "a palette without focus keys keeps the opaque border" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render android-mount "$dest"
  assert_file_contains "$dest/hyprland.lua" "active_border = \"rgba(8AB4F8ff)\""
  assert_file_contains "$dest/hyprland.lua" "gaps_out = 8"
}

@test "the prompt renders command duration in the layout" {
  local dest="$SANDBOX/render"
  mkdir -p "$dest"
  theme_render jan "$dest"
  assert_file_contains "$dest/starship.toml" '$cmd_duration'
  assert_file_contains "$dest/starship.toml" 'min_time = 100'
  # Exit code, privilege, container, virtualenv and VPN context.
  assert_file_contains "$dest/starship.toml" '$status'
  assert_file_contains "$dest/starship.toml" '[username]'
  assert_file_contains "$dest/starship.toml" '[container]'
  assert_file_contains "$dest/starship.toml" '${custom.venv}'
  assert_file_contains "$dest/starship.toml" '[custom.venv]'
  assert_file_contains "$dest/starship.toml" '[custom.vpn]'
  assert_file_contains "$dest/starship.toml" '/sys/class/net/tun0'
}

@test "theme list --names pairs the id with the display name" {
  run "$ARCHWAY_ROOT/bin/archway" theme list --names
  assert_eq 0 "$status"
  assert_contains "$output" "android-mount	Android Mount"
  assert_contains "$output" "mono-blue	Monochrome Blue"
}
